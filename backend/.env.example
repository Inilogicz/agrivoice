# AgriVoice backend configuration.
# Copy to .env and fill in. Never commit .env.
# Settings marked (dashboard) can also be changed live from /admin → Settings.

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO
DEBUG=false                      # true logs every SQL statement

# Comma-separated browser origins allowed to call the API (dashboard)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Password for the /admin dashboard. Empty disables the dashboard.
# Generate one with: openssl rand -hex 24
ADMIN_TOKEN=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (tables created automatically):
DATABASE_URL=sqlite+aiosqlite:///./agrivoice.db
# PostgreSQL (run `uv run alembic upgrade head` first):
# DATABASE_URL=postgresql+asyncpg://agrivoice:password@localhost:5432/agrivoice

# ── Models ────────────────────────────────────────────────────────────────────
# Hugging Face token from an account that accepted the NCAIR1 model licences
HF_TOKEN=hf_your_token_here
MODEL_CACHE_DIR=~/.cache/agrivoice-models
DEVICE=auto                      # auto = CUDA, else Apple Silicon (mps), else CPU

# true = every model is a labelled mock (no downloads, no GPU, no token)
DEV_USE_MOCK_MODELS=true

# Where N-ATLaS runs:
#   remote – a GPU elsewhere (Kaggle notebook / Hugging Face Space), see natlas-space/
#   local  – in this process; needs a GPU with ~20 GB memory
#   mock   – real speech models, placeholder answers
LLM_PROVIDER=mock
# default remote endpoint; /admin can override it
LLM_REMOTE_ENDPOINT=
LLM_DTYPE=bfloat16               # local provider only
LLM_MAX_NEW_TOKENS=350           # (dashboard)
REQUEST_TIMEOUT_SECONDS=120      # (dashboard)

# ── Language detection (Meta MMS-LID; NCAIR models do transcription and answers)
LANGUAGE_DETECTION_CONFIDENCE_THRESHOLD=0.6   # (dashboard) below this, the user picks
LANGUAGE_DETECTION_MAX_SECONDS=8              # (dashboard)

# ── Audio ─────────────────────────────────────────────────────────────────────
MAX_AUDIO_SIZE_MB=25             # (dashboard)
LOG_TRANSCRIPTS=false            # true logs transcripts (personal data); dev only

# ── N-ATLaS on Kaggle, started/stopped from /admin (LLM_PROVIDER=remote) ──────
# Kaggle → Settings → API → Generate New Token
KAGGLE_API_TOKEN=
# e.g. your-kaggle-username/agrivoice-natlas
KAGGLE_NOTEBOOK_ID=
# private dataset holding an hf_token file
KAGGLE_SECRETS_DATASET=
# this server's public https address
PUBLIC_BASE_URL=
NATLAS_DEFAULT_RUN_HOURS=4       # (dashboard)
NATLAS_WEEKLY_HOURS_LIMIT=28     # (dashboard) Kaggle allows 30 GPU hours/week
# private dataset with YarnGPT's decoder files (enables speech on Kaggle)
KAGGLE_TTS_DATASET=

# ── Spoken answers (YarnGPT2, generated on the N-ATLaS GPU) ───────────────────
TTS_ENABLED=false                # (dashboard)
TTS_SPEED=0.85                   # (dashboard) 1.0 = YarnGPT's natural pace
SPEECH_CACHE_DIR=./speech_cache
